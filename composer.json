{
    "name": "rsvpify/laravel-inky",
    "description": "Foundation Inky email templates in Laravel",
    "keywords": [
        "foundation",
        "inky",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Bryan Miller",
            "email": "bryan@kirschbaumdevelopment.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "incentfit/inky": "1.3.6.5",
        "illuminate/support": "^12.55|^13.10",
        "illuminate/view": "^12.55|^13.10",
        "symfony/dom-crawler": "^7.4.12|^8.0.12",
        "tijsverkoyen/css-to-inline-styles": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": ">=13.1 <13.2",
        "orchestra/testbench": "^10.11|^11.1",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "Rsvpify\\LaravelInky\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rsvpify\\Tests\\LaravelInky\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rsvpify\\LaravelInky\\InkyServiceProvider"
            ]
        }
    }
}
