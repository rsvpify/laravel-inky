{
    "name": "rsvpify/laravel-inky",
    "description": "Foundation Inky email templates in Laravel",
    "keywords": [
        "foundation",
        "inky",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Bryan Miller",
            "email": "bryan@kirschbaumdevelopment.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "incentfit/inky": "1.3.6.5",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "symfony/dom-crawler": "^2.7|^3.0|^4.0|^5.0|^7.0",
        "tijsverkoyen/css-to-inline-styles": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0|^9.0|^10.5|^11.0",
        "graham-campbell/testbench": "^5.3|^6.1"
    },
    "autoload": {
        "psr-4": {
            "Rsvpify\\LaravelInky\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rsvpify\\Tests\\LaravelInky\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rsvpify\\LaravelInky\\InkyServiceProvider"
            ]
        }
    }
}
